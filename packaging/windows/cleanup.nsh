; Paths are canonicalized and checked before any recursive cleanup. Never
; traverse junctions/symlinks: remove the link itself, not its external target.
!macro AVAC_CHECK_INSTALL_PATH FAILURE
  ; Win32 resolves an absolute lexical path even before a first installation
  ; creates its parent folders (NSIS GetFullPathName can fail in that case).
  System::Call 'kernel32::GetFullPathNameW(w "$INSTDIR", i ${NSIS_MAX_STRLEN}, w .r4, p 0) i.r3'
  ${If} $3 == 0
  ${OrIf} $3 >= ${NSIS_MAX_STRLEN}
    Goto ${FAILURE}
  ${EndIf}
  StrCpy $INSTDIR $4
  ${GetRoot} "$INSTDIR" $0
  ${If} $INSTDIR == ""
  ${OrIf} $INSTDIR == $0
  ${OrIf} $INSTDIR == "$0\"
  ${OrIf} $INSTDIR == "$PROFILE"
  ${OrIf} $INSTDIR == "$DOCUMENTS"
  ${OrIf} $INSTDIR == "$DESKTOP"
  ${OrIf} $INSTDIR == "$APPDATA"
  ${OrIf} $INSTDIR == "$LOCALAPPDATA"
  ${OrIf} $INSTDIR == "$LOCALAPPDATA\Programs"
  ${OrIf} $INSTDIR == "$PROGRAMFILES"
  ${OrIf} $INSTDIR == "$PROGRAMFILES64"
  ${OrIf} $INSTDIR == "$COMMONFILES"
  ${OrIf} $INSTDIR == "$COMMONFILES64"
  ${OrIf} $INSTDIR == "$WINDIR"
  ${OrIf} $INSTDIR == "$SYSDIR"
  ${OrIf} $INSTDIR == "$TEMP"
    Goto ${FAILURE}
  ${EndIf}
  ; Refuse a junction as the installation root, including when reached via a
  ; parent junction. The final path must equal the checked absolute path.
  ${If} ${FileExists} "$INSTDIR\."
    System::Call 'kernel32::CreateFileW(w "$INSTDIR", i 0, i 7, p 0, i 3, i 0x02000000, p 0) p.r1'
    ${If} $1 == -1
      Goto ${FAILURE}
    ${EndIf}
    System::Call 'kernel32::GetFinalPathNameByHandleW(p r1, w .r2, i ${NSIS_MAX_STRLEN}, i 0) i.r3'
    System::Call 'kernel32::CloseHandle(p r1)'
    StrCpy $2 $2 "" 4 ; Strip the Win32 \\?\ prefix.
    ${If} $2 != $INSTDIR
      Goto ${FAILURE}
    ${EndIf}
  ${EndIf}
!macroend

; Older uninstallers could leave empty directories or generated bytecode below
; _internal after deleting their marker. Recognize these at the default path
; so Setup can repair it. Unknown files or any reparse point still block it.
Function CheckLegacyResidue
  Exch $0
  Push $1
  Push $2
  Push $3
  Push $4
  System::Call 'kernel32::GetFileAttributesW(w r0) i.r4'
  IntOp $4 $4 & 0x400
  ${If} $4 != 0
    StrCpy $ResidueSafe 0
    Goto residue_done
  ${EndIf}
  FindFirst $1 $2 "$0\*"
  residue_loop:
    ${If} $2 == ""
      Goto residue_close
    ${EndIf}
    ${If} $2 == "."
    ${OrIf} $2 == ".."
      Goto residue_next
    ${EndIf}
    StrCpy $3 "$0\$2"
    System::Call 'kernel32::GetFileAttributesW(w r3) i.r4'
    IntOp $4 $4 & 0x410
    ${If} $4 >= 0x400
      StrCpy $ResidueSafe 0
      Goto residue_close
    ${EndIf}
    ${If} $4 != 0
      Push $3
      Call CheckLegacyResidue
    ${Else}
      StrLen $4 "$INSTDIR\_internal\"
      StrCpy $3 $3 $4
      ${If} $3 != "$INSTDIR\_internal\"
        StrCpy $ResidueSafe 0
      ${EndIf}
      ${GetFileExt} "$2" $4
      ${If} $4 != "pyc"
      ${AndIf} $4 != "pyo"
        StrCpy $ResidueSafe 0
      ${EndIf}
    ${EndIf}
    ${If} $ResidueSafe == 0
      Goto residue_close
    ${EndIf}
    residue_next:
      FindNext $1 $2
      Goto residue_loop
  residue_close:
    FindClose $1
  residue_done:
    Pop $4
    Pop $3
    Pop $2
    Pop $1
    Pop $0
FunctionEnd

; Input: an absolute, checked, Desktop-owned root on the stack. INSTDIR's two
; recovery files survive until every other deletion succeeds. Other roots are
; fixed app-data subdirectories, never paths taken from a project or preference.
Function un.RemoveOwnedTree
  Exch $0
  Push $1
  Push $2
  Push $3
  Push $4
  System::Call 'kernel32::GetFileAttributesW(w r0) i.r4'
  ${If} $4 == -1
    Goto tree_done
  ${EndIf}
  IntOp $4 $4 & 0x400
  ${If} $4 != 0
    ; A directory reparse point is a leaf. RMDir without /r unlinks it.
    ClearErrors
    RMDir "$0"
    IfErrors 0 tree_done
      StrCpy $CleanupFailed 1
      Goto tree_done
  ${EndIf}
  System::Call 'kernel32::CreateFileW(w r0, i 0, i 7, p 0, i 3, i 0x02000000, p 0) p.r1'
  System::Call 'kernel32::GetFinalPathNameByHandleW(p r1, w .r2, i ${NSIS_MAX_STRLEN}, i 0) i.r3'
  System::Call 'kernel32::CloseHandle(p r1)'
  StrCpy $2 $2 "" 4
  ${If} $2 != $0
    StrCpy $CleanupFailed 1
    Goto tree_done
  ${EndIf}
  ClearErrors
  FindFirst $1 $2 "$0\*"
  ${If} ${Errors}
    StrCpy $CleanupFailed 1
    Goto tree_done
  ${EndIf}
  tree_loop:
    ${If} $2 == ""
      Goto tree_close
    ${EndIf}
    ${If} $2 == "."
    ${OrIf} $2 == ".."
      Goto tree_next
    ${EndIf}
    ${If} $0 == $INSTDIR
      ${If} $2 == "avac-installation.ini"
      ${OrIf} $2 == "Uninstall.exe"
        Goto tree_next
      ${EndIf}
    ${EndIf}
    StrLen $3 $0
    StrLen $4 $2
    IntOp $4 $4 + $3
    IntOp $4 $4 + 1
    ${If} $4 >= ${NSIS_MAX_STRLEN}
      StrCpy $CleanupFailed 1
      Goto tree_next
    ${EndIf}
    StrCpy $3 "$0\$2"
    System::Call 'kernel32::GetFileAttributesW(w r3) i.r4'
    IntOp $4 $4 & 0x10
    ${If} $4 != 0
      Push $3
      Call un.RemoveOwnedTree
    ${Else}
      ClearErrors
      Delete "$3"
      ${If} ${Errors}
        ; Clear read-only only for real files, not linked targets.
        System::Call 'kernel32::GetFileAttributesW(w r3) i.r4'
        IntOp $4 $4 & 0x400
        ${If} $4 == 0
          SetFileAttributes "$3" NORMAL
          ClearErrors
          Delete "$3"
        ${EndIf}
        ${If} ${Errors}
          StrCpy $CleanupFailed 1
        ${EndIf}
      ${EndIf}
    ${EndIf}
    tree_next:
      FindNext $1 $2
      Goto tree_loop
  tree_close:
    FindClose $1
    ${If} $0 != $INSTDIR
      ClearErrors
      RMDir "$0"
      ${If} ${Errors}
        StrCpy $CleanupFailed 1
      ${EndIf}
    ${EndIf}
  tree_done:
    Pop $4
    Pop $3
    Pop $2
    Pop $1
    Pop $0
FunctionEnd
